# Copy to .env (never committed) and fill in locally.
# Leave empty values here: this file is public.

# --- Local mode (macOS) ---
# Things → Settings → General → Enable Things URLs → Manage → Copy token.
# Required only for update operations.
THINGS_AUTH_TOKEN=

# --- Hosted mode (phase 4) ---
# Use a DEDICATED TEST Things Cloud account, never your main one.
THINGS_CLOUD_EMAIL=
THINGS_CLOUD_PASSWORD=
