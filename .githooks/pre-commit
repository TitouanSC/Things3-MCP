#!/bin/sh
# Blocks commits that contain secrets. Enable with:
#   git config core.hooksPath .githooks
set -e
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (brew install gitleaks); secret scan skipped" >&2
  exit 0
fi
exec gitleaks git --pre-commit --staged --redact --no-banner .
